local function requestBoost()
 if playing and not book.Visible then remotes.Boost:FireServer() end
end
boostButton.Activated:Connect(requestBoost)
local function begin() if playing then return end;playing=true;tutorial.Visible=false;progress.Visible=true;remotes.Begin:FireServer() end
start.Activated:Connect(begin)
local keys={}; local touch={}; local stick=Vector2.zero; local orbit=0; local zoom=1; local dragging=false
UIS.InputBegan:Connect(function(i,processed)
 if processed then return end
 keys[i.KeyCode]=true
 if i.KeyCode==Enum.KeyCode.LeftShift or i.KeyCode==Enum.KeyCode.RightShift or i.KeyCode==Enum.KeyCode.ButtonX then requestBoost() end
 if i.KeyCode==Enum.KeyCode.Tab or i.KeyCode==Enum.KeyCode.ButtonY then toggleBook() end
 if i.KeyCode==Enum.KeyCode.Return or i.KeyCode==Enum.KeyCode.ButtonA then begin() end
 if i.UserInputType==Enum.UserInputType.MouseButton2 then dragging=true end
end)
UIS.InputEnded:Connect(function(i)
 keys[i.KeyCode]=nil
 if i.UserInputType==Enum.UserInputType.MouseButton2 then dragging=false end
end)
UIS.WindowFocusReleased:Connect(function() keys={}; touch={}; stick=Vector2.zero; dragging=false end)
UIS.InputChanged:Connect(function(i)
 if i.UserInputType==Enum.UserInputType.MouseWheel then zoom=math.clamp(zoom-i.Position.Z*.08,.65,1.9) end
 if dragging and i.UserInputType==Enum.UserInputType.MouseMovement then orbit-=i.Delta.X*.007 end
 if i.KeyCode==Enum.KeyCode.Thumbstick1 then stick=Vector2.new(i.Position.X,i.Position.Y); if stick.Magnitude&lt;.15 then stick=Vector2.zero end end
 if i.KeyCode==Enum.KeyCode.Thumbstick2 then orbit-=i.Position.X*.055 end
end)
local function held(...) for _,k in ipairs({...}) do if keys[k] then return 1 end end return 0 end
if UIS.TouchEnabled then
 local touchPanel=create('Frame',root,{Position=UDim2.new(0,20,1,-300),Size=UDim2.fromOffset(180,150),BackgroundTransparency=1})
 for _,spec in ipairs({{'↑',60,0,'forward'},{'↓',60,96,'back'},{'←',5,48,'left'},{'→',115,48,'right'}}) do
  local b=create('TextButton',touchPanel,{Position=UDim2.fromOffset(spec[2],spec[3]),Size=UDim2.fromOffset(52,48),Text=spec[1],TextSize=24,BackgroundColor3=cream,TextColor3=ink,BackgroundTransparency=.2,BorderSizePixel=0}); round(b,14)
  b.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.Touch then touch[spec[4]]=true end end)
  b.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.Touch then touch[spec[4]]=nil end end)
 end
 for n,spec in ipairs({{'RISE','up'},{'DIVE','down'}}) do
  local b=create('TextButton',root,{Position=UDim2.new(1,-98,1,-320+n*62),Size=UDim2.fromOffset(72,54),Text=spec[1],TextSize=12,Font=Enum.Font.GothamBold,BackgroundColor3=dark,TextColor3=mint,BorderSizePixel=0}); round(b,16)
  b.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.Touch then touch[spec[2]]=true end end)
  b.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.Touch then touch[spec[2]]=nil end end)
 end
end
remotes.Notice.OnClientEvent:Connect(function(message,kind)
 if not playing then return end
 if kind=='eat' then
  local words={'nom nom!','delish!','nice nibble!','yum!'}
  gain.Text=words[math.random(1,#words)];gainUntil=time()+.7
 else
  toast.Text=kind=='respawn' and 'Oops! Little fins, fresh start.' or 'Look at you grow! Hello, '..C.Tiers[player:GetAttribute('Tier') or 1].name..'!'
  toastPanel.Visible=true;toastUntil=time()+3.5
 end
end)
local uiTimer=0;local sendTimer=0;local focus=nil;local lastProgress=-1
local nicknames={'Little minnow','Peppy perch','Lovely bass','Zoomy tuna','Dashing marlin','Cheeky shark','Wonderful whale'}
local function updateUI(m)
 local tier=player:GetAttribute('Tier') or 1;local growth=player:GetAttribute('Growth') or 0;local score=player:GetAttribute('Score') or 0
 tierLabel.Text=nicknames[tier];fishBody.BackgroundColor3=C.Tiers[tier].color;fishTail.BackgroundColor3=C.Tiers[tier].color
 local fraction=math.clamp((growth-C.Tiers[tier].threshold)/C.progressSpan(tier),0,1)
 local boosting=(player:GetAttribute('BoostUntil') or 0)&gt;workspace:GetServerTimeNow()
 local available=growth-C.Tiers[tier].threshold&gt;=C.boostCost(tier)
 local shortcut=UIS.TouchEnabled and '' or UIS.GamepadEnabled and ' · X' or ' · Shift'
 boostButton.Text=boosting and 'Whoooosh!' or available and ('Zoom! '..shortcut) or 'Nibble to zoom!'
 boostButton.BackgroundColor3=available and mint or Color3.fromRGB(226,232,202)
 boostButton.AutoButtonColor=available and not boosting
 boostButton.Active=available and not boosting
 if tier&lt;7 then
  local base=C.Tiers[tier].threshold;local goal=C.Tiers[tier+1].threshold
  fraction=math.clamp((growth-base)/(goal-base),0,1)
  nextLabel.Text=fraction&gt;.8 and 'Nearly a '..C.Tiers[tier+1].name:lower()..'! Keep nibbling.' or 'Next little adventure: '..C.Tiers[tier+1].name
 else
  nextLabel.Text='Whale power: '..math.floor(score)..' • higher score wins'
 end
 if math.abs(fraction-lastProgress)&gt;.001 then
  lastProgress=fraction;TweenService:Create(fill,TweenInfo.new(.25),{Size=UDim2.fromScale(fraction,1)}):Play()
 end
 scoreLabel.Text='Your happy haul: '..math.floor(score)..' points'
 populationLabel.Text='A pond full of pals. Dots after names mean bots.'
 tips.Text=tier==1 and 'Leafy snacks first! Swim down and brush past the green seaweed to grow.' or tier==7 and 'Big fish energy! You can eat whales with fewer points than you. Equal scores? Swim as pals.' or 'Smaller fish are on the menu! Swim into them for a snack. Tiny bites and seaweed help a little less.'
 tips.Text..='\n\nZoom spends a little bar. Your tier and points stay!' 
 if book.Visible then
  local all=fish:GetChildren();table.sort(all,function(a,b) return (a:GetAttribute('Score') or 0)&gt;(b:GetAttribute('Score') or 0) end)
  for i,row in ipairs(rows) do
   local a=all[i];row.Text=a and string.format('%s%s     %d',string.sub(a:GetAttribute('DisplayName') or '',1,19),a:GetAttribute('Bot') and ' ·' or '',math.floor(a:GetAttribute('Score') or 0)) or ''
  end
  for id,d in pairs(dots) do if not fish:FindFirstChild(id) then d:Destroy();dots[id]=nil end end
  for _,a in ipairs(all) do if a.PrimaryPart then
   local d=dots[a.Name]
   if not d then d=create('Frame',map,{Size=UDim2.fromOffset(6,6),BorderSizePixel=0,AnchorPoint=Vector2.new(.5,.5)});round(d,5);dots[a.Name]=d end
   local p=a.PrimaryPart.Position;d.Position=UDim2.fromScale(.5+p.X/(C.Radius*2),.5+p.Z/(C.Radius*2))
   d.BackgroundColor3=a==m and ink or C.canEat({tier=a:GetAttribute('Tier') or 1,score=a:GetAttribute('Score') or 0},{tier=tier,score=score}) and Color3.fromRGB(226,116,106) or Color3.fromRGB(93,164,112)
   d.Size=UDim2.fromOffset(a==m and 9 or 5,a==m and 9 or 5)
  end end
 end
 hint.Text=not playing and '' or m and m:GetAttribute('Protected') and 'A little breathing room. You’re safe for a moment.' or tier==1 and 'Psst… the leafy snacks are down below.' or ''
 hint.Visible=not book.Visible;progress.Visible=playing and not book.Visible;bookButton.Visible=playing
 local w,h=root.AbsoluteSize.X,root.AbsoluteSize.Y
 local width=math.min(380,w-28);progress.Size=UDim2.fromOffset(width,137);progress.Position=UDim2.new(.5,-width/2,1,-159)
 tierLabel.Size=UDim2.fromOffset(width-108,28);tierLabel.TextSize=width&lt;340 and 19 or 22
 nextLabel.Size=UDim2.fromOffset(width-108,18);nextLabel.TextSize=width&lt;340 and 10 or 12
 for _,spec in ipairs({{tutorial,420,350},{book,440,410},{toastPanel,430,65}}) do
  local panel,sw,sh=spec[1],spec[2],spec[3]
  local scale=math.min(1,(w-28)/sw,(h-110)/sh)
  local u=panel:FindFirstChildOfClass('UIScale') or create('UIScale',panel,{Scale=scale});u.Scale=scale
  if panel==toastPanel then panel.Position=UDim2.new(.5,-sw*scale/2,0,130)
  else panel.Position=UDim2.new(.5,-sw*scale/2,.5,-sh*scale/2+20) end
 end
 hint.Size=UDim2.fromOffset(math.min(w-28,400),25);hint.Position=UDim2.new(.5,-math.min(w-28,400)/2,1,-191)
end
RunService.RenderStepped:Connect(function(dt)
 camera=workspace.CurrentCamera; camera.CameraType=Enum.CameraType.Scriptable
  local x=held(Enum.KeyCode.D,Enum.KeyCode.Right)-held(Enum.KeyCode.A,Enum.KeyCode.Left)+(touch.right and 1 or 0)-(touch.left and 1 or 0)+stick.X
  local z=held(Enum.KeyCode.W,Enum.KeyCode.Up)-held(Enum.KeyCode.S,Enum.KeyCode.Down)+(touch.forward and 1 or 0)-(touch.back and 1 or 0)+stick.Y
  local y=held(Enum.KeyCode.Space,Enum.KeyCode.E,Enum.KeyCode.ButtonR1)-held(Enum.KeyCode.Q,Enum.KeyCode.LeftControl,Enum.KeyCode.ButtonL1)+(touch.up and 1 or 0)-(touch.down and 1 or 0)
  local v=Vector3.new(math.clamp(x,-1,1),math.clamp(y,-1,1),math.clamp(z,-1,1))
  local controls=playing and not book.Visible and v or Vector3.zero
  sendTimer+=dt
  if sendTimer&gt;=.05 then sendTimer=0; swim:FireServer(controls) end
 local renderPosition=renderer:update(dt,controls)
 local m=fish:FindFirstChild('Player_'..player.UserId)
 if m and m.PrimaryPart then
  local p=renderPosition or m.PrimaryPart.Position
  focus=p
  local size=C.Tiers[player:GetAttribute('Tier') or 1].size
  local distance=(37+size*1.7)*zoom
  local offset=Vector3.new(math.sin(orbit)*distance,distance*.9,math.cos(orbit)*distance)
  camera.CFrame=CFrame.lookAt(focus+offset,focus); camera.FieldOfView=62

 end
 uiTimer+=dt; if uiTimer&gt;.15 then uiTimer=0; updateUI(m) end
 if time()&gt;toastUntil then toastPanel.Visible=false end
 if time()&gt;gainUntil then gain.Text='' end
end)
print('LITTLE POND: client ready. Keyboard, touch and gamepad controls online.')
</ProtectedString>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="RBX6920">
        <Properties>
          <string name="Name">WaterEffects</string>
          <ProtectedString name="Source">-- Lightweight local water effects. These decorative parts never affect gameplay.
local RS=game:GetService('ReplicatedStorage')
local RunService=game:GetService('RunService')
local C=require(RS:WaitForChild('Pond'):WaitForChild('Config'))
local water=workspace:WaitForChild('PondEnvironment'):WaitForChild('PondWater')
local glints={}
for _,p in ipairs(water:GetChildren()) do
 if p.Name=='Glint' then table.insert(glints,{part=p,base=p.CFrame}) end
end
local folder=Instance.new('Folder');folder.Name='LocalWaterEffects';folder.Parent=workspace
local tint=Instance.new('ColorCorrectionEffect');tint.Name='Underwater tint';tint.Parent=workspace.CurrentCamera
local rng=Random.new(143)
local bubbles={}; local flecks={}
local function cosmetic(name,size,color)
 local p=Instance.new('Part');p.Name=name;p.Size=size;p.Color=color;p.Anchored=true
 p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=false;p.Material=Enum.Material.Neon
 p.Parent=folder;return p
end
for i=1,40 do
 local a=rng:NextNumber(0,math.pi*2);local r=math.sqrt(rng:NextNumber())*C.shoreRadius(a)*.86
 local x,z=math.cos(a)*r,math.sin(a)*r;local floor=C.floorHeight(x,z)
 local p=cosmetic('Drifting bubble',Vector3.one*rng:NextNumber(.15,.4),Color3.fromRGB(191,239,223));p.Shape=Enum.PartType.Ball;p.Transparency=.6
 table.insert(bubbles,{part=p,x=x,z=z,floor=floor,phase=rng:NextNumber(0,35),speed=rng:NextNumber(1,2.2)})
end
for i=1,100 do
 local a=rng:NextNumber(0,math.pi*2);local r=math.sqrt(rng:NextNumber())*C.shoreRadius(a)*.84
 local x,z=math.cos(a)*r,math.sin(a)*r
 local p=cosmetic('Dappled light',Vector3.new(rng:NextNumber(2,5),.04,.3),Color3.fromRGB(218,245,188))
 p.CFrame=CFrame.new(x,C.floorHeight(x,z)+.14,z)*CFrame.Angles(0,rng:NextNumber(0,math.pi),0);p.Transparency=.85
 table.insert(flecks,p)
end
local accumulator=0
RunService.Heartbeat:Connect(function(dt)
 accumulator+=dt;if accumulator&lt;.1 then return end;accumulator=0
 local now=time()
 for i,g in ipairs(glints) do
  g.part.CFrame=g.base+Vector3.new(math.sin(now*.55+i)*1.3,math.sin(now*.8+i)*.045,0)
  g.part.Transparency=.62+.24*math.sin(now*.9+i*.7)
 end
 for i,b in ipairs(bubbles) do
  local height=math.max(2,C.Surface-b.floor-2)
  local y=b.floor+1+(now*b.speed+b.phase)%height
  b.part.Position=Vector3.new(b.x+math.sin(now*.6+i)*.5,y,b.z+math.cos(now*.5+i)*.5)
 end
 for i,p in ipairs(flecks) do p.Transparency=.83+.12*math.sin(now*1.3+i*.7) end
 local depth=math.clamp((C.Surface-workspace.CurrentCamera.CFrame.Position.Y)/22,0,1)
 tint.TintColor=Color3.new(1,1,1):Lerp(Color3.fromRGB(177,227,225),depth*.2)
 tint.Saturation=-depth*.06;tint.Contrast=depth*.025
end)
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerStorage" referent="RBX6921">
    <Properties>
      <string name="Name">ServerStorage</string>
    </Properties>
    <Item class="ModuleScript" referent="RBX6922">
      <Properties>
        <string name="Name">PondTests</string>
        <ProtectedString name="Source">-- Run in Studio command bar: require(game.ServerStorage.PondTests)()
return function()
 local C=require(game.ReplicatedStorage.Pond.Config)
 local count=0
 local function check(ok,msg) assert(ok,msg); count+=1 end
 for i=1,7 do
  check(C.tierFor(C.Tiers[i].threshold)==i,'tier boundary '..i)
  if i&gt;1 then check(C.tierFor(C.Tiers[i].threshold-.001)==i-1,'below tier boundary '..i) end
  for j=1,7 do check(C.canEat({tier=i,score=10},{tier=j,score=10})==(i&gt;j),'tier eating matrix') end
  check(C.reward(i,0)&gt;0,'all fish can eat seaweed')
 end
 check(C.canEat({tier=7,score=11},{tier=7,score=10}),'higher-score whale wins')
 check(not C.canEat({tier=7,score=10},{tier=7,score=11}),'lower-score whale loses')
 check(not C.canEat({tier=7,score=10},{tier=7,score=10}),'equal whales safe')
 check(not C.canEat({tier=2,score=10000},{tier=3,score=0}),'score cannot bypass tiers')
 for tier=2,7 do check(C.reward(tier,0)&lt;C.reward(tier-1,0) or C.reward(tier,0)==.08,'diminishing seaweed') end
 for tier=3,7 do check(C.reward(tier,tier-1)&gt;C.reward(tier,tier-2),'diminishing fish') end
 local p=C.clampPosition(Vector3.new(999,-100,999),15)
 check(Vector3.new(p.X,0,p.Z).Magnitude&lt;=C.swimRadius(math.atan2(p.Z,p.X),15)+.001,'irregular shoreline boundary')
 check(p.Y&gt;=C.floorHeight(p.X,p.Z)+1.2+15*.38-.001,'sculpted floor boundary')
 check(C.clampPosition(Vector3.new(0,999,0),15).Y&lt;=C.Surface-15*.35-2+.001,'surface boundary')
 if workspace:FindFirstChild('Fish') then
  check(#workspace.Fish:GetChildren()==20,'exactly 20 actors')
  check(#workspace.Seaweed:GetChildren()==C.SeaweedCount,'food population')
 end
 local B=require(game.ReplicatedStorage.Pond.BotBrain)
 local S=require(game.ReplicatedStorage.Pond.Swimming)
 local function actor(id,tier,pos)
  return {id=id,tier=tier,score=0,pos=pos,velocity=Vector3.zero,facing=Vector3.new(0,0,-1),intent=Vector3.zero,safe=-1,phase=0,bank=0}
 end
 local hunter=actor('hunter',3,Vector3.new(0,15,0))
 local prey=actor('prey',1,Vector3.new(50,15,0))
 local group={hunter=hunter,prey=prey}
 check(B.update(hunter,group,{},0)=='chase','bot acquires prey')
 for n=1,6 do prey.pos=Vector3.new(50-n*3,15,0); B.update(hunter,group,{},n) end
 check(hunter.brain.started==0,'progress never resets chase deadline')
 B.update(hunter,group,{},7.1)
 check(hunter.brain.target==nil,'bot abandons chase at deadline')
 check(hunter.brain.ignored.prey&gt;7.1,'timed-out prey gets cooldown')
 B.update(hunter,group,{},7.5)
 check(hunter.brain.target==nil,'bot does not immediately reacquire prey')
 B.update(hunter,group,{},14)
 check(hunter.brain.target==nil,'same prey remains ignored after general rest')
 B.update(hunter,group,{},22)
 check(hunter.brain.target==prey,'prey becomes eligible after cooldown')
 B.reset(hunter); B.update(hunter,group,{},30); B.update(hunter,group,{},33)
 check(hunter.brain.target==nil,'unproductive chase ends early')
 local swimmer=actor('swimmer',1,Vector3.new(0,20,0)); swimmer.player={}
 swimmer.velocity=Vector3.new(0,0,-20); swimmer.intent=Vector3.new(0,0,1)
 S.update(swimmer,.05,0)
 check(swimmer.velocity.Z&lt;0,'reversal turns through water instead of snapping')
 check(swimmer.velocity.Magnitude&lt;=22,'acceleration is bounded')
 local before=swimmer.velocity.Magnitude; swimmer.intent=Vector3.zero
 S.update(swimmer,.05,0)
 check(swimmer.velocity.Magnitude&gt;0 and swimmer.velocity.Magnitude&lt;before,'release coasts with drag')
 for _=1,60 do S.update(swimmer,.05,0) end
 check(swimmer.velocity.Magnitude&lt;.1,'coasting eventually settles')
 local turned=S.turn(Vector3.xAxis,-Vector3.xAxis,.1)
 check(turned.X==turned.X and turned.Magnitude&gt;.99,'opposite headings remain finite')
 check(math.acos(math.clamp(turned:Dot(Vector3.xAxis),-1,1))&lt;.101,'turn rate limit')
 local vertical=S.turn(Vector3.yAxis,-Vector3.yAxis,.1)
 check(vertical.Y==vertical.Y,'vertical reversal remains finite')
 for tier=1,7 do
  for n=0,71 do
   local a=n*math.pi/36;local size=C.Tiers[tier].size
   local v=C.clampPosition(Vector3.new(math.cos(a)*1000,-100,math.sin(a)*1000),size)
   check(v.Y&gt;=C.floorHeight(v.X,v.Z)+1.2+size*.38-.002,'all fish clear the bed')
   check(v.Y&lt;=C.Surface-size*.35-2+.002,'all fish remain below surface')
  end
 end
 check(math.abs(C.shoreRadius(0)-C.shoreRadius(math.pi))&gt;10,'asymmetric shoreline')
 check(C.floorHeight(-62,35)&lt;C.floorHeight(106,-74),'deep pocket differs from shallow garden')
 -- Tank steering is independent of the camera and travel direction.
 local tank=actor('tank',1,Vector3.new(0,20,0))
 tank.intent=Vector3.xAxis
 for _=1,60 do S.tank(tank,1/60) end
 check(tank.facing.X&gt;.8,'right input turns nose right')
 check((tank.pos-Vector3.new(0,20,0)).Magnitude&lt;.001,'turning in place does not strafe')
 tank=actor('tank',1,Vector3.new(0,20,0)); tank.intent=Vector3.new(0,0,-1)
 for _=1,60 do S.tank(tank,1/60) end
 check(tank.pos.Z&gt;0 and tank.facing.Z&lt;-.99,'reverse backs up without flipping heading')
 check(tank.velocity.Magnitude&lt;C.Tiers[1].speed*.43,'reverse is gentler than forward')
 tank.intent=Vector3.zero; local speed=tank.velocity.Magnitude
 S.tank(tank,.05)
 check(tank.velocity.Magnitude&gt;0 and tank.velocity.Magnitude&lt;speed,'tank coasts on release')
 tank.intent=Vector3.new(1,1,1)
 for _=1,300 do S.tank(tank,1/60) end
 check(tank.velocity.Magnitude&lt;=C.Tiers[1].speed+.001,'combined inputs cannot exceed swim speed')
 check(tank.pos.Y&lt;=C.Surface-C.Tiers[1].size*.35-2+.001,'tank respects water surface')
 local slow=actor('slow',1,Vector3.new(0,20,0)); local fast=actor('fast',1,slow.pos)
 slow.intent=Vector3.new(.3,0,1); fast.intent=slow.intent
 for _=1,20 do S.tank(slow,.05) end
 for _=1,60 do S.tank(fast,1/60) end
 check((slow.pos-fast.pos).Magnitude&lt;1,'server and render step rates remain close')
 check(slow.facing:Dot(fast.facing)&gt;.999,'tank turn rate independent of frame rate')
 for tier=1,7 do
  local base=C.Tiers[tier].threshold; local cost=C.boostCost(tier)
  local b=actor('boost',tier,Vector3.new(0,20,0)); b.ready=true; b.score=1000; b.growth=base+cost-.001
  check(not C.tryBoost(b),'insufficient progress rejects boost '..tier)
  check(b.growth==base+cost-.001 and not b.boostRemaining,'rejection changes nothing '..tier)
  b.growth=base+cost; b.ready=false
  check(not C.tryBoost(b),'welcome screen cannot boost '..tier)
  b.ready=true
  check(C.tryBoost(b),'exact cost grants boost '..tier)
  check(math.abs(b.growth-base)&lt;.00001 and b.tier==tier and b.score==1000,'cost preserves tier and score '..tier)
  b.growth=base+cost*2
  check(not C.tryBoost(b) and b.growth==base+cost*2,'active boost cannot stack or charge again '..tier)
  for _=1,30 do S.tank(b,1/60) end
  check(b.velocity.Magnitude&gt;C.Tiers[tier].speed*1.6,'boost accelerates even from rest '..tier)
  for _=1,120 do S.tank(b,1/60) end
  check(b.boostRemaining==0 and b.velocity.Magnitude&lt;C.Tiers[tier].speed,'boost expires and coasts '..tier)
  check(C.tryBoost(b),'can boost again with sufficient progress '..tier)
 end
 print('LITTLE POND TESTS PASSED: '..count..' checks')
 return count
end
</ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="Players" referent="RBX6923">
    <Properties>
      <string name="Name">Players</string>
      <bool name="CharacterAutoLoads">false</bool>
    </Properties>
  </Item>
