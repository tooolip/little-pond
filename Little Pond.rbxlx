{55.143853,54.298894,54.000012,53.810764,53.084687,52.419469,51.560383,50.384454,48.905921,47.236944,45.524178,43.233520,35.439433,23.432558,11.279170,4.666369,3.766876,4.105368,4.915702,5.413883,5.211731,6.811698,12.700253,22.999290,35.137882,43.912361,46.049335,47.640775,48.956077,50.154626,51.518465,53.367801,55.143853},
{54.708700,54.185187,54.000007,54.189808,54.242718,53.565638,52.818263,51.886823,50.732456,49.377066,47.879690,46.320042,44.895384,38.557119,26.236121,14.834385,8.602949,6.897009,7.407190,9.160930,12.649048,18.688895,27.233314,36.621407,43.641467,45.630095,47.044997,48.334518,49.509762,50.673152,51.994016,53.658963,54.708700},
{54.331393,54.086595,54.000004,54.088755,54.335287,54.654531,53.842001,52.951825,51.935170,50.772625,49.472729,48.074245,46.650094,45.301130,42.196394,34.178860,27.007291,23.114863,22.393772,24.366451,28.721946,34.748277,40.855765,44.694587,45.716797,46.830987,47.957935,49.071949,50.184439,51.345019,52.629895,54.086595,54.331393},
{54.080179,54.020951,54.000001,54.021474,54.081121,54.167139,54.262506,53.935847,52.930998,51.856198,50.697598,49.463647,48.193962,46.959418,45.847736,44.984181,42.998627,40.553133,39.657438,40.644736,42.824357,44.730825,45.369860,46.119467,46.962919,47.882034,48.863345,49.900293,50.994793,52.156826,53.401490,54.020951,54.080179},
{54.000497,54.000130,54.000000,54.000133,54.000503,54.001037,54.001628,54.002161,54.002529,53.243392,52.113618,50.934586,49.736834,48.576855,47.526698,46.656119,46.015589,45.627349,45.486242,45.567450,45.836824,46.260145,46.809051,47.463141,48.209182,49.038989,49.947250,50.929923,51.983318,53.103680,54.000000,54.000130,54.000497},
{54.106761,54.027897,54.000001,54.028593,54.108015,54.222550,54.349534,54.463837,54.542840,54.570910,54.284888,52.953575,51.619932,50.366264,49.269260,48.385244,47.744279,47.352844,47.200628,47.266943,47.524959,47.944280,48.493087,49.140557,49.859672,50.630228,51.441623,52.294721,53.201895,54.028593,54.000001,54.027897,54.106761},
{54.379748,54.099230,54.000004,54.101706,54.384210,54.791613,55.243293,55.649869,55.930885,56.030730,55.929647,55.647638,54.120872,52.510590,51.167271,50.151591,49.472969,49.110610,49.033197,49.207908,49.598752,50.160740,50.837175,51.563962,52.280483,52.943791,53.541802,54.101392,54.384210,54.101706,54.000004,54.099230,54.379748},
{54.770082,54.201226,54.000008,54.206247,54.779131,55.605292,56.521244,57.345730,57.915595,58.118069,57.913084,57.341206,56.515601,55.104988,53.273059,51.970274,51.201659,50.917224,51.047198,51.518154,52.250455,53.148606,54.097917,54.974963,55.670965,56.120960,56.329247,55.605292,54.779131,54.206247,54.000008,54.201226,54.770082},
{55.207159,54.315436,54.000013,54.323307,55.221344,56.516412,57.952232,59.244674,60.137978,60.455370,60.134042,59.237581,57.943386,56.507563,55.214244,53.841187,52.930349,52.774698,53.251710,54.215973,55.503215,56.925490,58.274927,59.346042,59.974999,59.244674,57.952232,56.516412,55.221344,54.323307,54.000013,54.315436,55.207159},
{55.611921,54.421202,54.000017,54.431713,55.630862,57.360168,59.277421,61.003220,62.196050,62.619864,62.190794,60.993749,59.265609,57.348352,55.621381,54.426442,54.000000,54.426442,55.593858,57.193896,59.186201,60.993749,62.190794,62.619864,62.196050,61.003220,59.277421,57.360168,55.630862,54.431713,54.000017,54.421202,55.611921}}
function M.radius(angle)
 return 244*(1+.115*math.sin(2*angle+.6)+.085*math.sin(3*angle-1.1)+.035*math.cos(5*angle))
end
function M.floorHeight(x,z)
 local u=math.clamp((x+M.Half)/M.Step,0,M.N-1-.00001)
 local v=math.clamp((z+M.Half)/M.Step,0,M.N-1-.00001)
 local i,j=math.floor(u)+1,math.floor(v)+1
 local a,b=u-math.floor(u),v-math.floor(v)
 local h00,h10,h01,h11=heights[i][j],heights[i+1][j],heights[i][j+1],heights[i+1][j+1]
 if a+b&lt;=1 then return h00+a*(h10-h00)+b*(h01-h00) end
 return h11+(1-a)*(h01-h11)+(1-b)*(h10-h11)
end
return M
</ProtectedString>
        </Properties>
      </Item>
    </Item>
