      <Item class="ModuleScript" referent="RBX6909">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source">-- Shared balancing rules. Score lasts for the session; growth resets when eaten.
local C = {}
local Map=require(script.Parent.WorldMap)
C.Capacity = 20
C.Radius = 310
C.Surface = 44
C.SeaweedCount = 300
C.SeaweedRespawn = 11
C.SpawnProtection = 5
C.Tiers = {
 {name='Minnow', threshold=0, size=2.5, speed=25, color=Color3.fromRGB(108,218,195)},
 {name='Perch', threshold=8, size=3.8, speed=27, color=Color3.fromRGB(255,191,85)},
 {name='Bass', threshold=30, size=5.3, speed=29, color=Color3.fromRGB(118,181,111)},
 {name='Tuna', threshold=75, size=7, speed=30, color=Color3.fromRGB(90,167,224)},
 {name='Marlin', threshold=160, size=9, speed=32, color=Color3.fromRGB(146,134,226)},
 {name='Shark', threshold=310, size=11.5, speed=29, color=Color3.fromRGB(105,142,173)},
 {name='Whale', threshold=550, size=15, speed=25, color=Color3.fromRGB(108,119,208)},
}
C.BoostDuration=1.2
C.BoostMultiplier=1.8
C.BoostCostFraction=.2
function C.progressSpan(tier)
 return tier&lt;#C.Tiers and C.Tiers[tier+1].threshold-C.Tiers[tier].threshold
  or C.Tiers[tier].threshold-C.Tiers[tier-1].threshold
end
function C.boostCost(tier) return C.progressSpan(tier)*C.BoostCostFraction end
function C.canBoost(a)
 return a.ready and (a.boostRemaining or 0)&lt;=0
  and a.growth-C.Tiers[a.tier].threshold&gt;=C.boostCost(a.tier)
end
function C.tryBoost(a)
 if not C.canBoost(a) then return false end
 a.growth-=C.boostCost(a.tier)
 a.boostRemaining=C.BoostDuration
 return true
end
function C.tierFor(growth)
 local tier=1
 for i,t in ipairs(C.Tiers) do if growth &gt;= t.threshold then tier=i end end
 return tier
end
function C.canEat(a,b)
 return a.tier &gt; b.tier or (a.tier == 7 and b.tier == 7 and a.score &gt; b.score)
end
function C.reward(predatorTier, preyTier)
 -- Seaweed is tier zero. Immediately lower prey always has the best return.
 if preyTier == 0 then return math.max(0.08, 0.48^(predatorTier-1)) end
 return 8 * 1.45^(preyTier-1) * 0.48^math.max(0,predatorTier-preyTier-1)
end
C.floorHeight=Map.floorHeight
C.shoreRadius=Map.radius
function C.swimRadius(angle,size)
 local radius=Map.radius(angle)*.94-size-3
 local ceiling=C.Surface-size*.35-2
 local clearance=1.2+size*.38
 local x,z=math.cos(angle),math.sin(angle)
 if Map.floorHeight(x*radius,z*radius)+clearance&gt;ceiling then
  local low,high=0,radius
  for _=1,14 do
   local mid=(low+high)/2
   if Map.floorHeight(x*mid,z*mid)+clearance&lt;=ceiling-.05 then low=mid else high=mid end
  end
  radius=low
 end
 return radius
end
function C.clampPosition(v, size)
 local r=C.swimRadius(math.atan2(v.Z,v.X),size)
 local flat=Vector3.new(v.X,0,v.Z)
 if flat.Magnitude &gt; r then flat=flat.Unit*r end
 local floor=Map.floorHeight(flat.X,flat.Z)+1.2+size*.38
 local ceiling=C.Surface-size*.35-2
 return Vector3.new(flat.X, math.clamp(v.Y,math.min(floor,ceiling),ceiling),flat.Z)
end
return C
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX6910">
        <Properties>
          <string name="Name">FishFactory</string>
          <ProtectedString name="Source">local C = require(script.Parent.Config)
local F = {}
local function part(model, name, size, cf, color, shape)
 local p=Instance.new(shape=='Wedge' and 'WedgePart' or 'Part')
 p.Name=name; p.Size=size; p.CFrame=cf; p.Color=color
 p.Anchored=true; p.CanCollide=false; p.CanTouch=false; p.CanQuery=false
 p.Material=Enum.Material.SmoothPlastic
 p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth
 if shape=='Ball' then p.Shape=Enum.PartType.Ball end
 p.Parent=model
 return p
end
-- Build a flat-shaded triangle from two wedge prisms: no uploaded meshes needed.
local function triangle(model,a,b,c,color)
 local ab,ac,bc=b-a,c-a,c-b
 if ab:Dot(ab)&gt;ac:Dot(ac) and ab:Dot(ab)&gt;bc:Dot(bc) then c,a=a,c
 elseif ac:Dot(ac)&gt;bc:Dot(bc) then a,b=b,a end
 ab,ac,bc=b-a,c-a,c-b
 local right=ac:Cross(ab).Unit; local back=bc.Unit; local up=bc:Cross(right).Unit
 local h=math.abs(ab:Dot(up))
 part(model,'Facet',Vector3.new(.035,h,math.max(.01,math.abs(ab:Dot(back)))),CFrame.fromMatrix((a+b)/2,right,up,back),color,'Wedge')
 part(model,'Facet',Vector3.new(.035,h,math.max(.01,math.abs(ac:Dot(back)))),CFrame.fromMatrix((a+c)/2,-right,up,-back),color,'Wedge')
end
function F.create(id, tier, name, isBot)
 local t=C.Tiers[tier]; local s=t.size
 local m=Instance.new('Model'); m.Name=id
 local color=t.color; local cream=Color3.fromRGB(244,242,205)
 local body=part(m,'Body',Vector3.new(s*.65,s*.72,s*1.5),CFrame.new(),color,'Ball')
 m.PrimaryPart=body; body.Transparency=1
 local width=tier==7 and .41 or .325
 -- A short, rounded snout ring softens the former needle-shaped head.
 for i=0,7 do
  local a=i*math.pi/4; local b=(i+1)*math.pi/4
  local p=Vector3.new(math.cos(a)*s*width,math.sin(a)*s*.36,0)
  local q=Vector3.new(math.cos(b)*s*width,math.sin(b)*s*.36,0)
  local noseWidth=tier==7 and .8 or .58
  local np=Vector3.new(p.X*noseWidth,p.Y*.64,-s*.43)
  local nq=Vector3.new(q.X*noseWidth,q.Y*.64,-s*.43)
  local shade=math.sin((a+b)/2)&lt;-.35 and cream or color:Lerp(cream,(i%3)*.065)
  triangle(m,np,p,q,shade);triangle(m,np,q,nq,shade)
  triangle(m,Vector3.new(0,0,-s*.66),np,nq,shade)
  triangle(m,Vector3.new(0,0,s*.75),q,p,shade)
 end
 local tailColor=color:Lerp(cream,.18)
 if tier==7 then
  for _,side in ipairs({-1,1}) do
   triangle(m,Vector3.new(0,0,s*.7),Vector3.new(side*s*.57,.02,s*1.07),Vector3.new(side*s*.13,.02,s*1.12),tailColor)
  end
 else
  for _,side in ipairs({-1,1}) do
   triangle(m,Vector3.new(0,0,s*.66),Vector3.new(0,side*s*.43,s*1.06),Vector3.new(0,side*s*.04,s*.98),tailColor)
  end
 end
 for _,side in ipairs({-1,1}) do
  part(m,'Fin',Vector3.new(s*.46,s*.09,s*.48),CFrame.new(side*s*.42,-s*.1,s*.1)*CFrame.Angles(0,side*-.42,side*.22),color:Lerp(cream,.2),'Wedge')
  part(m,'EyeWhite',Vector3.new(s*.13,s*.24,s*.24),CFrame.new(side*s*(tier==7 and .36 or .275),s*.10,-s*.26),Color3.new(1,1,1),'Ball')
  part(m,'Eye',Vector3.new(s*.075,s*.13,s*.13),CFrame.new(side*s*(tier==7 and .42 or .335),s*.10,-s*.28),Color3.fromRGB(24,44,61),'Ball')
  part(m,'EyeSparkle',Vector3.new(s*.025,s*.045,s*.045),CFrame.new(side*s*(tier==7 and .457 or .372),s*.13,-s*.30),Color3.new(1,1,1),'Ball')
 end
 for _,side in ipairs({-1,1}) do
  part(m,'Rosy cheek',Vector3.new(s*.035,s*.09,s*.13),CFrame.new(side*s*(tier==7 and .37 or .28),-s*.015,-s*.32),Color3.fromRGB(236,157,139),'Ball')
 end
 if tier&gt;=2 then
  part(m,'Dorsal',Vector3.new(s*.1,s*(tier==5 and .8 or .36),s*.62),CFrame.new(0,s*.43,s*.03),color:Lerp(Color3.fromRGB(25,68,97),.22),'Wedge')
 end
 if tier==2 or tier==3 then
  for z=-1,1 do
   for _,side in ipairs({-1,1}) do
    part(m,'Stripe',Vector3.new(s*.025,s*.42,s*.085),CFrame.new(side*s*(z==0 and .328 or z==1 and .231 or .273),0,z*s*.23)*CFrame.Angles(0,side*(z==1 and -.41 or .29),0),color:Lerp(Color3.fromRGB(29,78,71),.4))
   end
  end
 end
 if tier==5 then part(m,'Bill',Vector3.new(s*.11,s*.1,s*.9),CFrame.new(0,0,-s*1.04),color,'Wedge') end
 if tier==6 then
  for _,side in ipairs({-1,1}) do
   for i=1,3 do part(m,'Gill',Vector3.new(s*.03,s*.2,s*.035),CFrame.new(side*s*.318,0,-s*.12+i*s*.08),Color3.fromRGB(47,79,102)) end
  end
 end
 if tier==7 then
  part(m,'Blowhole',Vector3.new(s*.12,s*.02,s*.14),CFrame.new(0,s*.318,-s*.11),Color3.fromRGB(58,76,119),'Ball')
  for i=-2,2 do part(m,'ThroatPleat',Vector3.new(s*.025,s*.02,s*.58),CFrame.new(i*s*.075,-s*.365,-s*.16),Color3.fromRGB(193,202,227)) end
 end
 local tag=Instance.new('BillboardGui'); tag.Name='Nameplate'; tag.Size=UDim2.fromOffset(190,40)
 tag.StudsOffset=Vector3.new(0,s*.65+1,0); tag.AlwaysOnTop=false; tag.MaxDistance=75; tag.Parent=body
 local txt=Instance.new('TextLabel'); txt.Name='Label'; txt.Size=UDim2.fromScale(1,1); txt.BackgroundTransparency=1
 txt.Font=Enum.Font.GothamBold; txt.TextSize=12; txt.TextColor3=Color3.fromRGB(246,255,249)
 txt.TextStrokeColor3=Color3.fromRGB(23,66,74); txt.TextStrokeTransparency=.3
 txt.Text=name..(isBot and ' · BOT' or ''); txt.Parent=tag
 m:SetAttribute('Tier',tier); m:SetAttribute('Bot',isBot); m:SetAttribute('DisplayName',name)
 return m
end
return F
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX6911">
        <Properties>
          <string name="Name">Swimming</string>
          <ProtectedString name="Source">-- Shared water movement: bounded turning, acceleration, coasting and stroke cadence.
local C=require(script.Parent.Config)
local S={}
function S.turn(from,to,limit)
 local dot=math.clamp(from:Dot(to),-1,1)
 local angle=math.acos(dot)
 if angle&lt;.0001 then return to end
 local axis=from:Cross(to)
 if axis.Magnitude&lt;.0001 then
  axis=from:Cross(math.abs(from.Y)&lt;.9 and Vector3.yAxis or Vector3.xAxis)
 end
 return CFrame.fromAxisAngle(axis.Unit,math.min(angle,limit)):VectorToWorldSpace(from).Unit
end
function S.update(a,dt,now)
 local t=C.Tiers[a.tier]
 local speed=a.velocity.Magnitude
 local strength=math.min(1,a.intent.Magnitude)
 local direction=speed&gt;.01 and a.velocity.Unit or a.facing
 local phase=a.phase or 0
 if strength&gt;.02 then
  local wanted=a.intent.Unit
  local agility=(a.player and 2.9 or 1.75)/(1+(a.tier-1)*.075)
  direction=S.turn(direction,wanted,agility*dt)
  local alignment=math.max(0,direction:Dot(wanted))
  local stroke=1+.075*math.sin(now*4.2+phase)
  local targetSpeed=t.speed*strength*(.58+.42*alignment)*stroke
  local acceleration=a.player and 38 or 24
  speed+=math.clamp(targetSpeed-speed,-acceleration*dt,acceleration*dt)
 else
  speed*=math.exp(-2.2*dt)
  if speed&lt;.025 then speed=0 end
 end
 a.velocity=direction*speed
 local raw=a.pos+a.velocity*dt
 a.pos=C.clampPosition(raw,t.size)
 -- Slide along pond edges rather than accumulating velocity against the wall.
 local correction=raw-a.pos
 if correction.Magnitude&gt;.0001 then
  local normal=correction.Unit
  a.velocity-=normal*math.max(0,a.velocity:Dot(normal))
 end
 if a.velocity.Magnitude&gt;.1 then
  a.facing=S.turn(a.facing,a.velocity.Unit,3.8*dt)
 end
 local turn=a.facing:Cross(direction).Y
 a.bank=(a.bank or 0)+(-turn*.35-(a.bank or 0))*(1-math.exp(-dt*5))
end
-- Tank input: X steers, Y changes depth, Z is signed forward thrust.
-- Heading stays independent of velocity, so reversing never flips the fish.
function S.tank(a,dt)
 local t=C.Tiers[a.tier]
 local steer=math.clamp(a.intent.X,-1,1)
 local thrust=math.clamp(a.intent.Z,-1,1)
 local boosting=(a.boostRemaining or 0)&gt;0
 local boostFraction=dt&gt;0 and math.min(a.boostRemaining or 0,dt)/dt or 0
 a.boostRemaining=math.max(0,(a.boostRemaining or 0)-dt)
 if boosting and math.abs(thrust)&lt;.01 then thrust=1 end
 a.yaw=(a.yaw or math.atan2(-a.facing.X,-a.facing.Z))-steer*2.15/(1+(a.tier-1)*.09)*dt
 local heading=Vector3.new(-math.sin(a.yaw),0,-math.cos(a.yaw))
 local target=(heading*thrust*(thrust&lt;0 and .42 or 1)+Vector3.yAxis*a.intent.Y*.65)
 if target.Magnitude&gt;1 then target=target.Unit end
 target*=t.speed*(1+(C.BoostMultiplier-1)*boostFraction)
 local response=boosting and 8 or a.intent.Magnitude&gt;.01 and 3.8 or 2.2
 a.velocity=a.velocity:Lerp(target,1-math.exp(-response*dt))
 local raw=a.pos+a.velocity*dt
 a.pos=C.clampPosition(raw,t.size)
 local correction=raw-a.pos
 if correction.Magnitude&gt;.0001 then
  local normal=correction.Unit
  a.velocity-=normal*math.max(0,a.velocity:Dot(normal))
 end
 local pitch=math.clamp(a.velocity.Y/t.speed,-.5,.5)
 a.facing=(heading+Vector3.yAxis*pitch).Unit
 a.bank=(a.bank or 0)+(-steer*.18*math.min(1,a.velocity.Magnitude/t.speed)-(a.bank or 0))*(1-math.exp(-5*dt))
end
return S
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX6912">
        <Properties>
          <string name="Name">FishRenderer</string>
          <ProtectedString name="Source">-- Client-only visuals. Gameplay remains authoritative on the server.
local F=require(script.Parent.FishFactory)
local S=require(script.Parent.Swimming)
local C=require(script.Parent.Config)
local R={}
function R.new(remote,ownId)
 local folder=Instance.new('Folder'); folder.Name='FishVisuals'; folder.Parent=workspace
 local entries={}; local history={}; local input=Vector3.zero
 local function simulate(a,duration)
  -- Bound catch-up after a stalled frame or connection.
  local remaining=math.clamp(duration,0,.25)
  while remaining&gt;0 do local dt=math.min(remaining,1/60); S.tank(a,dt); remaining-=dt end
 end
 remote.OnClientEvent:Connect(function(stamp,packet)
  local now=workspace:GetServerTimeNow(); local present={}
  for _,snapshot in ipairs(packet) do
   local id=snapshot.id; present[id]=true
   local e=entries[id]
   if e and e.generation~=snapshot.generation then e.model:Destroy(); entries[id]=nil; e=nil end
   if not e then
    e={model=F.create(id,snapshot.tier,snapshot.name,snapshot.bot),generation=snapshot.generation,samples={}}
    e.model.Parent=folder; entries[id]=e
   end
   table.insert(e.samples,{time=stamp,state=snapshot})
   while #e.samples&gt;8 do table.remove(e.samples,1) end
   if id==ownId then
    local previous=e.renderPos
    local a=table.clone(snapshot); local cursor=stamp
    -- Replay locally sampled controls since this authoritative snapshot.
    local active=history[1] and history[1].value or input
    for _,command in ipairs(history) do
     if command.time&lt;=stamp then active=command.value
     elseif command.time&lt;=now then
      a.intent=active; simulate(a,command.time-cursor); cursor=command.time; active=command.value
     end
    end
    a.intent=active; simulate(a,now-cursor); e.predicted=a
    e.offset=previous and (previous-a.pos) or Vector3.zero
    if e.offset.Magnitude&gt;12 then e.offset=Vector3.zero; e.renderFacing=nil end
   end
  end
  for id,e in pairs(entries) do if not present[id] then e.model:Destroy(); entries[id]=nil end end
 end)
 function R:update(dt,controls)
  local now=workspace:GetServerTimeNow()
  if controls~=input or #history==0 then input=controls; table.insert(history,{time=now,value=input}) end
  while #history&gt;1 and history[2].time&lt;now-1 do table.remove(history,1) end
  local ownPosition
  for id,e in pairs(entries) do
   local pos,facing,bank,velocity,phase
   if id==ownId and e.predicted then
    local a=e.predicted; a.intent=input; simulate(a,dt)
    e.offset*=math.exp(-dt*12)
    pos=C.clampPosition(a.pos+e.offset,C.Tiers[a.tier].size)
    facing=a.facing; bank=a.bank; velocity=a.velocity; phase=a.phase
   else
    -- Interpolate a short distance behind the server to bridge packet arrivals.
    local renderTime=now-.1; local samples=e.samples; local left=samples[1]; local right=left
    for i=2,#samples do
     right=samples[i]
     if right.time&gt;=renderTime then break end
     left=right
    end
    local a,b=left.state,right.state
    local alpha=right.time&gt;left.time and math.clamp((renderTime-left.time)/(right.time-left.time),0,1) or 0
    pos=a.pos:Lerp(b.pos,alpha); facing=S.turn(a.facing,b.facing,math.acos(math.clamp(a.facing:Dot(b.facing),-1,1))*alpha)
    if renderTime&gt;right.time then pos+=b.velocity*math.min(renderTime-right.time,.1) end
    pos=C.clampPosition(pos,C.Tiers[b.tier].size)
    bank=a.bank+(b.bank-a.bank)*alpha; velocity=b.velocity; phase=b.phase
   end
   e.renderPos=pos
   e.renderFacing=id==ownId and e.renderFacing and S.turn(e.renderFacing,facing,6*dt) or facing
   local up=math.abs(e.renderFacing.Y)&gt;.97 and Vector3.xAxis or Vector3.yAxis
   local sway=math.sin(now*4.2+phase)*.028*math.min(1,velocity.Magnitude/10)
   e.model:PivotTo(CFrame.lookAt(pos,pos+e.renderFacing,up)*CFrame.Angles(0,sway,bank))
   if id==ownId then ownPosition=pos end
  end
  return ownPosition
 end
 return R
end
return R
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX6913">
        <Properties>
          <string name="Name">BotBrain</string>
          <ProtectedString name="Source">local C=require(script.Parent.Config)
local B={}
B.ChaseDuration=7
B.StallDuration=2.5
B.IgnoreDuration=14
B.RestDuration=6
local function unit(v,fallback) return v.Magnitude&gt;.001 and v.Unit or fallback end
function B.reset(a)
 a.brain={ignored={},restUntil=0,mode='wander'}
end
local function abandon(brain,now)
 if brain.target then brain.ignored[brain.target.id]=now+B.IgnoreDuration end
 brain.target=nil; brain.restUntil=now+B.RestDuration; brain.food=nil
end
function B.update(a,actors,weeds,now)
 if not a.brain then B.reset(a) end
 local brain=a.brain
 for id,untilTime in pairs(brain.ignored) do if untilTime&lt;=now then brain.ignored[id]=nil end end
 local threat; local threatDistance=42
 for _,other in pairs(actors) do
  if other~=a and other.safe&lt;=now and C.canEat(other,a) then
   local distance=(other.pos-a.pos).Magnitude
   if distance&lt;threatDistance then threat=other; threatDistance=distance end
  end
 end
 local target=brain.target
 if target then
  local distance=(target.pos-a.pos).Magnitude
  if actors[target.id]~=target or target.safe&gt;now or not C.canEat(a,target) or distance&gt;95
    or now-brain.started&gt;=B.ChaseDuration or now-brain.progressAt&gt;=B.StallDuration then
   abandon(brain,now); target=nil
  elseif distance&lt;brain.bestDistance-2 then
   brain.bestDistance=distance; brain.progressAt=now
  end
 end
 local aim; local throttle=.68
 if threat then
  if brain.target then abandon(brain,now) end
  brain.mode='flee'
  aim=a.pos+unit(a.pos-threat.pos,a.facing)*35; throttle=1
 elseif not target and now&gt;=brain.restUntil then
  local nearest=65
  for _,other in pairs(actors) do
   if other~=a and other.safe&lt;=now and not brain.ignored[other.id] and C.canEat(a,other) then
    local distance=(other.pos-a.pos).Magnitude
    if distance&lt;nearest then nearest=distance; target=other end
   end
  end
  if target then
   brain.target=target; brain.started=now; brain.progressAt=now; brain.bestDistance=nearest
  end
 end
 if not threat then
  if target then
   brain.mode='chase'; throttle=.96
   -- A modest lead produces curved interception instead of nose-to-tail pursuit.
   aim=target.pos+target.velocity*.25
  else
   local w=brain.food
   if not w or w.ready&gt;now then
    w=nil; local nearest=75
    for _,candidate in ipairs(weeds) do if candidate.ready&lt;=now then
     local distance=(candidate.pos-a.pos).Magnitude
     if distance&lt;nearest then nearest=distance; w=candidate end
    end end
    brain.food=w
   end
   if w then brain.mode='forage'; aim=w.pos
   else
    brain.mode='wander'
    if not brain.waypoint or now&gt;brain.wanderUntil or (brain.waypoint-a.pos).Magnitude&lt;8 then
     local phase=a.phase or 0
     brain.waypoint=C.clampPosition(a.pos+Vector3.new(math.sin(now*.37+phase)*40,math.sin(now*.19+phase)*8,math.cos(now*.31+phase)*40),C.Tiers[a.tier].size)
     brain.wanderUntil=now+4.5
    end
    aim=brain.waypoint; throttle=.5
   end
  end
 end
 local delta=aim-a.pos; local distance=delta.Magnitude
 local dir=unit(delta,a.facing)
 local side=unit(dir:Cross(Vector3.yAxis),Vector3.xAxis)
 local phase=a.phase or 0
 -- Continuous wandering fades near food, so weaving cannot prevent a bite.
 local weave=math.min(1,distance/14)*(brain.mode=='chase' and .07 or .19)
 dir=unit(dir+side*math.sin(now*1.1+phase)*weave+Vector3.yAxis*math.sin(now*.8+phase)*weave*.25,dir)
 if brain.mode=='forage' or brain.mode=='wander' then throttle*=math.clamp(distance/10,.22,1) end
 local flat=Vector3.new(a.pos.X,0,a.pos.Z)
 local boundary=C.swimRadius(math.atan2(flat.Z,flat.X),C.Tiers[a.tier].size)
 if flat.Magnitude&gt;boundary-18 then
  dir=unit(dir-flat.Unit*math.clamp((flat.Magnitude-(boundary-18))/12,0,1.6),-flat.Unit)
 end
 a.intent=distance&gt;.5 and dir*throttle or Vector3.zero
 return brain.mode
end
return B
</ProtectedString>
        </Properties>
      </Item>
